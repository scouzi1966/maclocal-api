+        downWeight: MLXArray,
+        downScales: MLXArray,
+        indices: MLXArray,
+        scores: MLXArray,
+        activationLimit: Float,
+        stream: StreamOrDevice = .default
+    ) -> MLXArray {
+        var result = mlx_array_new()
+        mlx_fast_deepseek_v4_mxfp4_moe(
