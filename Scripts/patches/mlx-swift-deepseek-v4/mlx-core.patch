+        dot(x1, AFM_DSV4_FP4X4(
+#if AFM_DSV4_INTERLEAVED_MXFP4
+            up0High
+#else
+            up0 >> 16
+#endif
+        )) + dot(x2, AFM_DSV4_FP4X4(up1)) + dot(x3, AFM_DSV4_FP4X4(
+#if AFM_DSV4_INTERLEAVED_MXFP4
+            up1High
+#else
+            up1 >> 16
+#endif
+        )));
