From 2d59cbd2d7acc9997531f618d5d5454c8e5c2b23 Mon Sep 17 00:00:00 2001
From: scouzi1966 <58265937+scouzi1966@users.noreply.github.com>
Date: Wed, 5 Aug 2026 20:01:45 -0400
Subject: [PATCH] Support externally mapped AFM checkpoints

---
 ds4.c | 116 +++++++++++++++++++++++++++++++++++++++++++++++++---------
 ds4.h |  18 +++++++++
 2 files changed, 117 insertions(+), 17 deletions(-)

diff --git a/ds4.c b/ds4.c
index cf0615f..ff25365 100644
--- a/ds4.c
+++ b/ds4.c
@@ -2441,11 +2441,103 @@ static void parse_tensors(ds4_model *m, ds4_cursor *c) {
  * MTLBuffers; CPU uses a private read-only mapping to avoid Darwin VM stress.
  * Tokenizer-only callers pass prefetch_cpu=false so inspecting tokens never
  * walks the huge tensor payload. */
+static void model_parse_mapping(ds4_model *m) {
+    ds4_cursor c = cursor_at(m, 0);
+    uint32_t magic;
+    if (!cursor_u32(&c, &magic)) ds4_die(c.error);
+    if (magic != DS4_GGUF_MAGIC) ds4_die("model is not a GGUF file");
+    if (!cursor_u32(&c, &m->version)) ds4_die(c.error);
+    if (!cursor_u64(&c, &m->n_tensors)) ds4_die(c.error);
+    if (!cursor_u64(&c, &m->n_kv)) ds4_die(c.error);
+
+    if (m->version != 3) ds4_die("only GGUF v3 is supported");
+
+    parse_metadata(m, &c);
+    parse_tensors(m, &c);
+}
+
+static void model_open_external_mapping(ds4_model *m, const char *metadata_path,
+                                        const ds4_model_mapping *mapping) {
+    const long raw_page = sysconf(_SC_PAGESIZE);
+    const uint64_t page = raw_page > 0 ? (uint64_t)raw_page : 4096u;
+    if (!mapping || !mapping->regions || mapping->region_count == 0 ||
+        mapping->virtual_size == 0 || mapping->virtual_size % page != 0) {
+        ds4_die("invalid external model mapping");
+    }
+
+    void *base = mmap(NULL, (size_t)mapping->virtual_size, PROT_NONE,
+                      MAP_PRIVATE | MAP_ANON, -1, 0);
+    if (base == MAP_FAILED) ds4_die_errno("cannot reserve external model mapping", metadata_path);
+
+    int metadata_fd = open(metadata_path, O_RDONLY);
+    if (metadata_fd == -1) ds4_die_errno("cannot open model metadata", metadata_path);
+    struct stat metadata_stat;
+    if (fstat(metadata_fd, &metadata_stat) == -1) {
+        close(metadata_fd);
+        ds4_die_errno("cannot stat model metadata", metadata_path);
+    }
+    const uint64_t metadata_length = align_up((uint64_t)metadata_stat.st_size, page);
+    if (metadata_stat.st_size < 32 || metadata_length > mapping->virtual_size) {
+        close(metadata_fd);
+        ds4_die("external model metadata is invalid");
+    }
+    void *metadata_map = mmap(base, (size_t)metadata_length, PROT_READ,
+                              MAP_PRIVATE | MAP_FIXED, metadata_fd, 0);
+    close(metadata_fd);
+    if (metadata_map == MAP_FAILED) {
+        munmap(base, (size_t)mapping->virtual_size);
+        ds4_die_errno("cannot map model metadata", metadata_path);
+    }
+
+    for (size_t i = 0; i < mapping->region_count; i++) {
+        const ds4_model_map_region *region = &mapping->regions[i];
+        if (!region->path || !region->path[0] || region->length == 0 ||
+            region->virtual_offset % page != 0 || region->file_offset % page != 0 ||
+            region->length % page != 0 ||
+            region->virtual_offset > mapping->virtual_size ||
+            region->length > mapping->virtual_size - region->virtual_offset ||
+            region->virtual_offset < metadata_length) {
+            munmap(base, (size_t)mapping->virtual_size);
+            ds4_die("invalid external model map region");
+        }
+        int fd = open(region->path, O_RDONLY);
+        if (fd == -1) {
+            munmap(base, (size_t)mapping->virtual_size);
+            ds4_die_errno("cannot open external model region", region->path);
+        }
+        struct stat st;
+        if (fstat(fd, &st) == -1 || region->file_offset > (uint64_t)st.st_size ||
+            region->length - page >= (uint64_t)st.st_size - region->file_offset) {
+            close(fd);
+            munmap(base, (size_t)mapping->virtual_size);
+            ds4_die("external model region exceeds its file");
+        }
+        void *mapped = mmap((uint8_t *)base + region->virtual_offset,
+                            (size_t)region->length, PROT_READ,
+                            MAP_SHARED | MAP_FIXED, fd, (off_t)region->file_offset);
+        close(fd);
+        if (mapped == MAP_FAILED) {
+            munmap(base, (size_t)mapping->virtual_size);
+            ds4_die_errno("cannot map external model region", region->path);
+        }
+    }
+
+    m->fd = -1;
+    m->map = base;
+    m->size = mapping->virtual_size;
+    model_parse_mapping(m);
+}
+
 static void model_open(ds4_model *m, const char *path, bool metal_mapping,
-                       bool prefetch_cpu) {
+                       bool prefetch_cpu, const ds4_model_mapping *external_mapping) {
     memset(m, 0, sizeof(*m));
     m->fd = -1;
 
+    if (external_mapping) {
+        model_open_external_mapping(m, path, external_mapping);
+        return;
+    }
+
     int fd = open(path, O_RDONLY);
     if (fd == -1) ds4_die_errno("cannot open model", path);
 
@@ -2473,18 +2565,7 @@ static void model_open(ds4_model *m, const char *path, bool metal_mapping,
     m->map = map;
     m->size = (uint64_t)st.st_size;
 
-    ds4_cursor c = cursor_at(m, 0);
-    uint32_t magic;
-    if (!cursor_u32(&c, &magic)) ds4_die(c.error);
-    if (magic != DS4_GGUF_MAGIC) ds4_die("model is not a GGUF file");
-    if (!cursor_u32(&c, &m->version)) ds4_die(c.error);
-    if (!cursor_u64(&c, &m->n_tensors)) ds4_die(c.error);
-    if (!cursor_u64(&c, &m->n_kv)) ds4_die(c.error);
-
-    if (m->version != 3) ds4_die("only GGUF v3 is supported");
-
-    parse_metadata(m, &c);
-    parse_tensors(m, &c);
+    model_parse_mapping(m);
 
     if (!metal_mapping && prefetch_cpu) model_prefetch_cpu_mapping(m);
 }
@@ -51045,7 +51126,7 @@ int ds4_dump_text_tokenization(const char *model_path, const char *text, FILE *f
     token_vec tokens = {0};
 
     if (!fp) fp = stdout;
-    model_open(&model, model_path, false, false);
+    model_open(&model, model_path, false, false, NULL);
     config_validate_model(&model);
     vocab_load(&vocab, &model);
     tokenize_rendered_chat_vocab(&vocab, text ? text : "", &tokens);
@@ -56071,7 +56152,8 @@ static int ds4_engine_open_internal(ds4_engine **out,
 
     const bool graph_backend = ds4_backend_uses_graph(opt->backend);
     if (graph_backend) ds4_linux_graph_backend_set_oom_score(opt->backend);
-    model_open(&e->model, opt->model_path, graph_backend, !opt->inspect_only);
+    model_open(&e->model, opt->model_path, graph_backend, !opt->inspect_only,
+               opt->model_mapping);
     if (opt->warm_weights) model_warm_weights(&e->model);
     config_validate_model(&e->model);
     if (load_slice && load_layer_end == UINT32_MAX) {
@@ -56271,7 +56353,7 @@ static int ds4_engine_open_internal(ds4_engine **out,
     if (opt->inspect_only) {
         if (opt->mtp_path && opt->mtp_path[0] &&
             opt->distributed.role == DS4_DISTRIBUTED_NONE) {
-            model_open(&e->mtp_model, opt->mtp_path, false, false);
+            model_open(&e->mtp_model, opt->mtp_path, false, false, NULL);
             ds4_dspark_summary dspark = {0};
             e->support_kind =
                 support_model_detect(&e->mtp_model, &e->support_stages, &dspark);
@@ -56373,7 +56455,7 @@ static int ds4_engine_open_internal(ds4_engine **out,
             *out = NULL;
             return 1;
         }
-        model_open(&e->mtp_model, opt->mtp_path, graph_backend, true);
+        model_open(&e->mtp_model, opt->mtp_path, graph_backend, true, NULL);
         ds4_dspark_summary dspark = {0};
         e->support_kind =
             support_model_detect(&e->mtp_model, &e->support_stages, &dspark);
diff --git a/ds4.h b/ds4.h
index a8a0177..d233215 100644
--- a/ds4.h
+++ b/ds4.h
@@ -59,6 +59,23 @@ typedef struct {
 typedef struct ds4_engine ds4_engine;
 typedef struct ds4_session ds4_session;
 
+/* Optional externally-described model mapping. The metadata file contains a
+ * GGUF header and tensor directory, while regions supply the tensor bytes from
+ * other files (for example AFM safetensor shards) in one virtual address range.
+ * Offsets and lengths must be page aligned. */
+typedef struct {
+    const char *path;
+    uint64_t virtual_offset;
+    uint64_t file_offset;
+    uint64_t length;
+} ds4_model_map_region;
+
+typedef struct {
+    uint64_t virtual_size;
+    const ds4_model_map_region *regions;
+    size_t region_count;
+} ds4_model_mapping;
+
 typedef void (*ds4_session_progress_fn)(void *ud, const char *event, int current, int total);
 typedef bool (*ds4_session_cancel_fn)(void *ud);
 
@@ -126,6 +143,7 @@ typedef struct {
 
 typedef struct {
     const char *model_path;
+    const ds4_model_mapping *model_mapping;
     const char *mtp_path;
     ds4_backend backend;
     int n_threads;
-- 
